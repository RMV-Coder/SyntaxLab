{"id":"ptb-revised","name":"Penn Treebank (revised; NML nodes, split hyphens)","url":"https://stanfordnlp.github.io/stanza/constituency.html","kind":"constituency","source":"https://catalog.ldc.upenn.edu/docs/LDC99T42/","entries":{"ROOT":{"name":"root","definition":"The artificial top node added by the parser above the sentence.","url":null,"textbook":null,"family":null,"values":{},"language_notes":{}},"S":{"name":"simple declarative clause","definition":"A clause, typically a subject noun phrase followed by a verb phrase. Not used for clauses introduced by a complementizer (see SBAR) or for inverted questions (see SQ).","url":null,"textbook":"S (TP/IP in X-bar theory)","family":null,"values":{},"language_notes":{}},"SBAR":{"name":"subordinate clause","definition":"A clause introduced by a (possibly empty) subordinating word such as \"that\", \"because\", \"if\" or a relative pronoun.","url":null,"textbook":"S′ / CP","family":null,"values":{},"language_notes":{}},"SBARQ":{"name":"direct wh-question","definition":"A direct question introduced by a wh-word or wh-phrase (\"What did you see?\").","url":null,"textbook":"CP","family":null,"values":{},"language_notes":{}},"SINV":{"name":"inverted declarative clause","definition":"A declarative clause in which the subject follows the verb or auxiliary, e.g. after a fronted phrase or in quotation inversion (\"'Hi,' said Mary\").","url":null,"textbook":null,"family":null,"values":{},"language_notes":{}},"SQ":{"name":"inverted question","definition":"An inverted yes/no question, or the main clause of a wh-question after the wh-phrase (\"Did the students read the book?\").","url":null,"textbook":null,"family":null,"values":{},"language_notes":{}},"NP":{"name":"noun phrase","definition":"A phrase headed by a noun or pronoun (\"the child\", \"she\", \"rice\").","url":null,"textbook":"NP (DP in some theories)","family":null,"values":{},"language_notes":{}},"NML":{"name":"nominal modifier phrase","definition":"Marks a sub-constituent inside a noun phrase, typically a pre-modifier made of several words (\"[NML New York] lawyer\"). Added in the revised Penn Treebank.","url":null,"textbook":null,"family":null,"values":{},"language_notes":{}},"NX":{"name":"head of a complex noun phrase","definition":"Marks the head noun group in certain complex noun phrases, e.g. under coordination.","url":null,"textbook":"N′ (N-bar), roughly","family":null,"values":{},"language_notes":{}},"VP":{"name":"verb phrase","definition":"A phrase headed by a verb, including its objects and complements. Auxiliaries take a VP complement, which is why \"is eating rice\" contains a VP inside a VP.","url":null,"textbook":"VP","family":null,"values":{},"language_notes":{}},"PP":{"name":"prepositional phrase","definition":"A preposition and its complement (\"with a telescope\").","url":null,"textbook":"PP","family":null,"values":{},"language_notes":{}},"ADJP":{"name":"adjective phrase","definition":"A phrase headed by an adjective (\"very tall\", \"proud of her work\").","url":null,"textbook":"AP / AdjP","family":null,"values":{},"language_notes":{}},"ADVP":{"name":"adverb phrase","definition":"A phrase headed by an adverb (\"very quickly\").","url":null,"textbook":"AdvP","family":null,"values":{},"language_notes":{}},"QP":{"name":"quantifier phrase","definition":"A complex measure or amount inside a noun phrase (\"about 5 %\", \"more than three\").","url":null,"textbook":null,"family":null,"values":{},"language_notes":{}},"PRT":{"name":"particle","definition":"The particle of a phrasal verb (\"pick [up] the book\").","url":null,"textbook":null,"family":null,"values":{},"language_notes":{}},"CONJP":{"name":"conjunction phrase","definition":"A multiword conjunction (\"as well as\", \"rather than\").","url":null,"textbook":null,"family":null,"values":{},"language_notes":{}},"UCP":{"name":"unlike coordinated phrase","definition":"A coordination of phrases of different categories (\"old and in pain\").","url":null,"textbook":null,"