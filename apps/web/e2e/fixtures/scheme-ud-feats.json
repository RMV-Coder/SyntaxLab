    "Voice": {
      "name": "voice",
      "definition": "The relation between the verb and its arguments. Note that languages differ: Tagalog \"voice\" marks which argument is in focus and is not the same as the English passive.",
      "url": "https://universaldependencies.org/u/feat/Voice.html",
      "textbook": null,
      "family": null,
      "values": {
        "Act": {
          "name": "active",
          "gloss": "ACT",
          "gloss_standard": false
        },
        "Pass": {
          "name": "passive",
          "gloss": "PASS",
          "gloss_standard": true
        },
        "Cau": {
          "name": "causative",
          "gloss": "CAUS",
          "gloss_standard": true
        },
        "Bfoc": {
          "name": "beneficiary focus",
          "gloss": "BFOC",
          "gloss_standard": false
        },
        "Lfoc": {
          "name": "location focus",
          "gloss": "LFOC",
          "gloss_standard": false
        }
      },
      "language_notes": {
        "tl": "UD Tagalog annotates patient voice as Pass, which SyntaxLab shows as the treebank has it. Calling it a passive is contested: the actor remains a core argument (obj:agent), unlike the demoted agent of an English passive. Lfoc and Bfoc mark location and beneficiary voice."
      }
    },
