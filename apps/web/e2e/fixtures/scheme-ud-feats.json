{"id":"ud-feats","name":"Universal features (UD v2)","url":"https://universaldependencies.org/u/feat/","kind":"features","source":"https://universaldependencies.org/u/feat/","entries":{"Number":{"name":"number","definition":"Grammatical number of a nominal, or agreement with it on a verb.","url":"https://universaldependencies.org/u/feat/Number.html","textbook":null,"family":null,"values":{"Sing":{"name":"singular","gloss":"SG","gloss_standard":true},"Plur":{"name":"plural","gloss":"PL","gloss_standard":true},"Ptan":{"name":"plurale tantum (plural-only noun, e.g. \"scissors\")","gloss":null,"gloss_standard":true}},"language_notes":{}},"Person":{"name":"person","definition":"Distinguishes the speaker (1), the addressee (2) and others (3), on pronouns and on verbs that agree with them.","url":"https://universaldependencies.org/u/feat/Person.html","textbook":null,"family":null,"values":{"1":{"name":"first person","gloss":"1","gloss_standard":true},"2":{"name":"second person","gloss":"2","gloss_standard":true},"3":{"name":"third person","gloss":"3","gloss_standard":true}},"language_notes":{}},"Case":{"name":"case","definition":"Marks the role of a nominal in the clause. English shows case only on pronouns (\"I/me/my\") and with possessive \"'s\".","url":"https://universaldependencies.org/u/feat/Case.html","textbook":null,"family":null,"values":{"Nom":{"name":"nominative","gloss":"NOM","gloss_standard":true},"Acc":{"name":"accusative","gloss":"ACC","gloss_standard":true},"Gen":{"name":"genitive","gloss":"GEN","gloss_standard":true},"Dat":{"name":"dative","gloss":"DAT","gloss_standard":true},"Loc":{"name":"locative","gloss":"LOC","gloss_standard":true}},"language_notes":{}},"Gender":{"name":"gender","definition":"Grammatical gender; in English visible only on third-person singular pronouns.","url":"https://universaldependencies.org/u/feat/Gender.html","textbook":null,"family":null,"values":{"Masc":{"name":"masculine","gloss":"M","gloss_standard":true},"Fem":{"name":"feminine","gloss":"F","gloss_standard":true},"Neut":{"name":"neuter","gloss":"N","gloss_standard":true}},"language_notes":{}},"Tense":{"name":"tense","definition":"Locates the event in time relative to a reference point, usually the moment of speech.","url":"https://universaldependencies.org/u/feat/Tense.html","textbook":null,"family":null,"values":{"Past":{"name":"past","gloss":"PST","gloss_standard":true},"Pres":{"name":"present","gloss":"PRS","gloss_standard":true},"Fut":{"name":"future","gloss":"FUT","gloss_standard":true}},"language_notes":{}},"Aspect":{"name":"aspect","definition":"The internal temporal structure of an event (completed, ongoing, ...).","url":"https://universaldependencies.org/u/feat/Aspect.html","textbook":null,"family":null,"values":{"Perf":{"name":"perfect","gloss":"PRF","gloss_standard":true},"Imp":{"name":"imperfective","gloss":"IPFV","gloss_standard":true},"Prog":{"name":"progressive","gloss":"PROG","gloss_standard":true}},"language_notes":{}},"Mood":{"name":"mood","definition":"The speaker's stance toward the proposition (statement, command, condition, ...).","url":"https://universaldependencies.org/u/feat/Mood.html","textbook":null,"family":null,"values":{"Ind":{"name":"indicative","gloss":"IND","gloss_standard":true},"Imp":{"name":"imperative","gloss":"IMP","gloss_standard":true},"Sub":{"name":"subjunctive","gloss":"SBJV","gloss_standard":true},"Cnd":{"name":"conditional","gloss":"COND","gloss_standard":true},"Pot":{"name":"potential","gloss":"POT","gloss_standard":false}},"language_notes":{}},"VerbForm":{"name":"form of verb","definition":"Whether a verb form is finite (inflected for tense/mood) or a non-finite form.","url":"https://universaldependencies.org/u/feat/VerbForm.html","textbook":null,"family":null,"values":{"Fin":{"name":"finite verb","gloss":"FIN","gloss_standard":false},"Inf":{"name":"infinitive","gloss":"INF","gloss_standard":true},"Part":{"name":"participle","gloss":"PTCP","gloss_standard":true},"Ger":{"name":"gerund","gloss":"GER","gloss_standard":false}},"language_notes":{}},"Voice":{"name":"voice","definition":"The relation between the verb and its arguments. Note that languages differ: Tagalog \"voice\" marks which argument is in focus and is not the same as the English passive.","url":"https://universaldependencies.org/u/feat/Voice.html","textbook":null,"family":null,"values":{"Act":{"name":"active","gloss":"ACT","gloss_standard":false},"Pass":{"name":"passive","gloss":"PASS","gloss_standard":true},"Cau":{"name":"causative","gloss":"CAUS","gloss_standard":true},"Bfoc":{"name":"beneficiary focus","gloss":"BFOC","gloss_standard":false},"Lfoc":{"name":"location focus","gloss":"LFOC","gloss_standard":false}},"language_notes":{}},"Definite":{"name":"definiteness","definition":"Whether the noun phrase refers to something identifiable to the hearer.","url":"https://universaldependencies.org/u/feat/Definite.html","textbook":null,"family":null,"values":{"Def":{"name":"definite","gloss":"DEF","gloss_standard":true},"Ind":{"name":"indefinite","gloss":"INDF","gloss_standard":true}},"language_notes":{}},"PronType":{"name":"pronominal type","definition":"The subclass of a pronoun or determiner.","url":"https://universaldependencies.org/u/feat/PronType.html","textbook":null,"family":null,"values":{"Prs":{"name":"personal or possessive","gloss":null,"gloss_standard":true},"Art":{"name":"article","gloss":"ART","gloss_standard":true},"Dem":{"name":"demonstrative","gloss":"DEM","gloss_standard":true},"Int":{"name":"interrogative","gloss":"INT","gloss_standard":false},"Rel":{"name":"relative","gloss":"REL","gloss_standard":true},"Ind":{"name":"indefinite","gloss":"INDF","gloss_standard":true},"Tot":{"name":"total (collective, e.g. \"every\")","gloss":"TOT","gloss_standard":false},"Neg":{"name":"negative (e.g. \"no\", \"nobody\")","gloss":"NEG","gloss_standard":true},"Rcp":{"name":"reciprocal","gloss":"RECP","gloss_standard":true}},"language_notes":{}},"Poss":{"name":"possessive","definition":"Marks possessive pronouns and determiners (\"my\", \"their\").","url":"https://universaldependencies.org/u/feat/Poss.html","textbook":null,"family":null,"values":{"Yes":{"name":"possessive","gloss":"POSS","gloss_standard":true}},"language_notes":{}},"Reflex":{"name":"reflexive","definition":"Marks reflexive pronouns (\"herself\").","url":"https://universaldependencies.org/u/feat/Reflex.html","textbook":null,"family":null,"values":{"Yes":{"name":"reflexive","gloss":"REFL","gloss_standard":true}},"language_notes":{}},"Polarity":{"name":"polarity","definition":"Whether a word expresses negation (\"not\", \"no\") or affirmation.","url":"https://universaldependencies.org/u/feat/Polarity.html","textbook":null,"family":null,"values":{"Neg":{"name":"negative","gloss":"NEG","gloss_standard":true},"Pos":{"name":"positive","gloss":null,"gloss_standard":true}},"language_notes":{}},"Degree":{"name":"degree of comparison","definition":"The degree of an adjective or adverb (big, bigger, biggest).","url":"https://universaldependencies.org/u/feat/Degree.html","textbook":null,"family":null,"values":{"Pos":{"name":"positive (base form)","gloss":null,"gloss_standard":true},"Cmp":{"name":"comparative","gloss":"CMPR","gloss_standard":false},"Sup":{"name":"superlative","gloss":"SUPL","gloss_standard":false}},"language_notes":{}},"NumType":{"name":"numeral type","definition":"The subclass of a numeral (cardinal, ordinal, ...).","url":"https://universaldependencies.org/u/feat/NumType.html","textbook":null,"family":null,"values":{"Card":{"name":"cardinal (one, two)","gloss":null,"gloss_standard":true},"Ord":{"name":"ordinal (first, second)","gloss":null,"gloss_standard":true},"Mult":{"name":"multiplicative (twice)","gloss":null,"gloss_standard":true},"Frac":{"name":"fraction (half)","gloss":null,"gloss_standard":true}},"language_notes":{}},"NumForm":{"name":"numeral form","definition":"How a numeral is written (digits, words, Roman numerals).","url":"https://universaldependencies.org/u/feat/NumForm.html","textbook":null,"family":null,"values":{"Digit":{"name":"digits","gloss":null,"gloss_standard":true},"Word":{"name":"words","gloss":null,"gloss_standard":true},"Roman":{"name":"Roman numerals","gloss":null,"gloss_standard":true},"Combi":{"name":"combination of digits and words","gloss":null,"gloss_standard":true}},"language_notes":{}},"Abbr":{"name":"abbreviation","definition":"The word is an abbreviation.","url":"https://universaldependencies.org/u/feat/Abbr.html","textbook":null,"family":null,"values":{"Yes":{"name":"abbreviation","gloss":null,"gloss_standard":true}},"language_notes":{}},"Foreign":{"name":"foreign word","definition":"The word is from another language and not integrated into this one.","url":"https://universaldependencies.org/u/feat/Foreign.html","textbook":null,"family":null,"values":{"Yes":{"name":"foreign","gloss":null,"gloss_standard":true}},"language_notes":{}},"Typo":{"name":"typo","definition":"The word is misspelled in the source text.","url":"https://universaldependencies.org/u/feat/Typo.html","textbook":null,"family":null,"values":{"Yes":{"name":"misspelled","gloss":null,"gloss_standard":true}},"language_notes":{}},"ExtPos":{"name":"external part of speech","definition":"The part of speech that a fixed multiword expression has as a whole (e.g. \"because of\" behaves like an adposition).","url":"https://universaldependencies.org/u/feat/ExtPos.html","textbook":null,"family":null,"values":{},"language_notes":{}}}}