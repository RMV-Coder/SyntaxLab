    "Case": {
      "name": "case",
      "definition": "Marks the role of a nominal in the clause. English shows case only on pronouns (\"I/me/my\") and with possessive \"'s\".",
      "url": "https://universaldependencies.org/u/feat/Case.html",
      "textbook": null,
      "family": null,
      "values": {
        "Nom": {
          "name": "nominative",
          "gloss": "NOM",
          "gloss_standard": true
        },
        "Acc": {
          "name": "accusative",
          "gloss": "ACC",
          "gloss_standard": true
        },
        "Gen": {
          "name": "genitive",
          "gloss": "GEN",
          "gloss_standard": true
        },
        "Dat": {
          "name": "dative",
          "gloss": "DAT",
          "gloss_standard": true
        },
        "Loc": {
          "name": "locative",
          "gloss": "LOC",
          "gloss_standard": true
        }
      },
      "language_notes": {
        "tl": "These values follow the form of the marker, not the role of the argument. Gen covers ng whether it marks an actor, an undergoer or a possessor; Nom covers ang, whichever role the voice of the verb selects."
      }
    },
