        "Prog": {
          "name": "progressive",
          "gloss": "PROG",
          "gloss_standard": true
        }
      },
      "language_notes": {
        "tl": "The model only distinguishes Imp and Perf. The contemplative (kakain, 'will eat') has no value of its own. Capitalized sentence-initial verbs can get the wrong aspect."
      }
