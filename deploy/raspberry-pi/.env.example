# The tunnel's token, from the Cloudflare dashboard. It is a secret: it lets anyone who has it
# serve traffic for your hostname. Keep it in this file on the Pi only (.env is git-ignored).
CLOUDFLARE_TUNNEL_TOKEN=

# Web origins allowed to call the API (JSON list).
SYNTAXLAB_CORS_ORIGINS=["https://syntaxlab-nine.vercel.app"]
