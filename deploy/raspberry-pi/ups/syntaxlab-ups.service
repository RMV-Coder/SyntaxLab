[Unit]
Description=Shut down cleanly before the UPS HAT's batteries run out
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/syntaxlab-ups.py monitor
EnvironmentFile=-/etc/default/syntaxlab-ups
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
