# Public hostname of the API. It must resolve to this VM's public IP before Caddy starts,
# so that Let's Encrypt can verify it (e.g. a free DuckDNS subdomain).
SYNTAXLAB_API_HOST=your-name.duckdns.org

# Web origins allowed to call the API (JSON list).
SYNTAXLAB_CORS_ORIGINS=["https://syntaxlab-nine.vercel.app"]
